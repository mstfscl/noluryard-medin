<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoClicker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      Overlay pencereleri Service context'inden inflate ediliyor ve orada
      AppCompat/Material widget degistirici yok. Bu yuzden overlay temasi
      bilerek saf framework temasindan tureniyor: hicbir kutuphane attribute'una
      bagimli olmadan Button/TextView/ProgressBar guvenle sisirilebilsin.
    -->
    <style name="Theme.AutoClicker.Overlay" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
