<?xml version="1.0" encoding="utf-8"?>
<!--
  Yuzen balon. Iki durumu var:
    - collapsed : 56dp'lik daire, sadece sayac gosterir
    - panel     : genis kontrol paneli
  Ayni pencerede iki cocuk tutuluyor; gecis sadece visibility degisimi,
  boylece pencere yeniden eklenmiyor ve konum korunuyor.

  NOT: Overlay tarafinda bilerek klasik View kullaniliyor, Compose degil.
  Sebep: 100 CPS'te calisirken her 100 ms'de bir metin guncelleniyor;
  klasik TextView.setText() yolu recomposition'dan belirgin sekilde ucuz ve
  bu uygulamanin tum meselesi zaten CPU butcesini korumak. Ana uygulama
  ekrani tamamen Compose.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/collapsed"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_bubble">

        <TextView
            android:id="@+id/collapsedText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/on_panel"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="0" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/overlay_title"
                android:textColor="@color/on_panel"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMinimize"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/overlay_minimize"
                android:src="@drawable/ic_minimize" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/overlay_close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/counters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/on_panel"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="0 / ∞  •  0.0 sn / ∞" />

        <ProgressBar
            android:id="@+id/progressClicks"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_clicks" />

        <ProgressBar
            android:id="@+id/progressTime"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_clicks" />

        <TextView
            android:id="@+id/speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/on_panel_dim"
            android:textSize="12sp"
            android:text="0.0 / 0 CPS" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_accent"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/overlay_start"
                android:textAllCaps="false"
                android:textColor="@color/on_panel"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTargets"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:drawableStart="@drawable/ic_target"
                android:drawablePadding="4dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/overlay_targets"
                android:textAllCaps="false"
                android:textColor="@color/on_panel"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
