<?xml version="1.0" encoding="utf-8"?>
<!--
  Kalibrasyon kalkani.
  Kalibrasyon sirasinda gercek jestler gonderiliyor; alttaki oyuna/uygulamaya
  yanlislikla dokunmamak icin ekranin tamami bu dokunulabilir pencere ile
  ortuluyor ve test dokunuslari buraya dusuyor.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shield_bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/calibrating_title"
            android:textColor="@color/on_panel"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shieldBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/calibrating_body"
            android:textColor="@color/on_panel_dim"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/shieldProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="6dp"
            android:layout_marginTop="14dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_clicks" />
    </LinearLayout>
</FrameLayout>
